MODEL=wa-quarks-r1-p16-lat
MODEL_PATH=/work/wa/models/wa-quarks-r1-p16-lat.h5
DATA_DIR=/work/wa/data/wa-quarks-r1-p16-lat
RF=1
PREC='ap_fixed<16,6>'
STRAT=Latency
# Alveo U250 (DDR), hls4ml with DDR board support (fork commit; upstream review pending). No card stage.
BOARD=alveo-u250
SLR=SLR0
SLR_DSP=2577   # 0.85 x 3032 free DSPs of SLR0: headroom for the DDR controller next to the kernel
